  "keyOnly": [
    {
      "label": "linked exact key is excluded, unmatched key remains",
      "masterNames": [
        "GZP_B1234"
      ],
      "keys": {
        "GZP_B1234": "Existing site key",
        "XYZ_C9999": "Orphan key"
      },
      "expected": [
        {
          "name": "XYZ_C9999",
          "v": "Orphan key",
          "aliases": [
            "9999",
            "XYZ9999",
            "XYZ_C9999"
          ]
        }
      ]
    },
    {
      "label": "matching region and number with incompatible type remains",
      "masterNames": [
        "GZP_B1234"
      ],
      "keys": {
        "GZP_C1234": "Same site by region and number",
        "ABCD_B1234": "Unmatched key"
      },
      "expected": [
        {
          "name": "ABCD_B1234",
          "v": "Unmatched key",
          "aliases": [
            "1234",
            "ABCD1234",
            "ABCD_B1234"
          ]
        },
        {
          "name": "GZP_C1234",
          "v": "Same site by region and number",
          "aliases": [
            "1234",
            "GZP1234",
            "GZP_C1234"
          ]
        }
      ]
    },
    {
      "label": "empty key values are ignored",
      "masterNames": [],
      "keys": {
        "EMPTY": "  ",
        "SITE_B4321": "Valid orphan"
      },
      "expected": [
        {
          "name": "SITE_B4321",
          "v": "Valid orphan",
          "aliases": [
            "4321",
            "SITE4321",
            "SITE_B4321"
          ]
        }
      ]
    }
